#!/usr/bin/env python3
"""Stand-in for the external Gray process: record real argv/cwd/env effects."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

args = sys.argv[1:]
resume = None
if args[:1] == ["--session"]:
    resume = args[1]
    args = args[2:]
assert args[0] == "-p", args
prompt = args[1]
json_mode = "--json" in args[2:]
SID = "fake-child-session"
mode = os.environ.get("FAKE_MODE", "ok")
if mode == "slow":
    time.sleep(float(os.environ.get("FAKE_SLEEP", "30")))
if mode == "descendant":
    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
    Path(os.environ["FAKE_LOG"]).write_text(str(child.pid))
    time.sleep(60)
if mode == "fail":
    print("deliberate child failure", file=sys.stderr)
    sys.exit(7)
if mode == "flood":
    while True:
        sys.stdout.write("x" * 65536)
        sys.stdout.flush()
if mode == "chatty":
    print(json.dumps({"protocol": 1, "session_id": SID, "type": "progress",
                      "phase": "tool_ran", "tool": "bash", "label": "Bash",
                      "detail": "early tool"}), flush=True)
    time.sleep(float(os.environ.get("FAKE_SLEEP", "2")))
if mode == "empty":
    sys.exit(0)
payload = {"prompt": prompt, "cwd": os.getcwd(), "resume": resume,
           "active": os.environ.get("GRAY_SUBAGENTS_ACTIVE")}
if json_mode:
    print(json.dumps({"protocol": 1, "session_id": SID, "type": "progress",
                      "phase": "tool_ran", "tool": "bash", "label": "Bash",
                      "detail": "fake tool ran"}))
    print(json.dumps({"protocol": 1, "session_id": SID, "type": "result",
                      "text": json.dumps(payload)}))
else:
    print(json.dumps(payload))
