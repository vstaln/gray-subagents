#!/usr/bin/env python3
"""Stand-in for the external Gray process: record real argv/cwd/env effects."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

args = sys.argv[1:]
resume = None
if args[:1] == ["--session"]:
    resume = args[1]
    args = args[2:]
assert args[0] == "-p", args
prompt = args[1]
json_mode = "--json" in args[2:]
SID = "fake-child-session"
mode = os.environ.get("FAKE_MODE", "ok")
# FAKE_MODE_FILE holds one line "mode[:sleep_secs]" read fresh at each child
# start — lets a single host env drive per-run/per-phase behavior in e2e.
mode_file = os.environ.get("FAKE_MODE_FILE")
if mode_file:
    try:
        spec = Path(mode_file).read_text().strip().splitlines()[0].strip()
        mode, _, spec_sleep = spec.partition(":")
        if spec_sleep:
            os.environ["FAKE_SLEEP"] = spec_sleep
    except (OSError, IndexError):
        pass
if mode == "slow":
    time.sleep(float(os.environ.get("FAKE_SLEEP", "30")))
if mode == "descendant":
    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
    Path(os.environ["FAKE_LOG"]).write_text(str(child.pid))
    time.sleep(60)
if mode == "fail":
    print("deliberate child failure", file=sys.stderr)
    sys.exit(7)
if mode == "flood":
    while True:
        sys.stdout.write("x" * 65536)
        sys.stdout.flush()
if mode == "chatty":
    print(json.dumps({"protocol": 1, "session_id": SID, "type": "progress",
                      "phase": "tool_ran", "tool": "bash", "label": "Bash",
                      "detail": "early tool"}), flush=True)
    time.sleep(float(os.environ.get("FAKE_SLEEP", "2")))
if mode == "empty":
    sys.exit(0)
if mode == "sessfail":
    # Fails like "fail" but leaves a resumable child session and a successful
    # tool row first, so the run stays steerable and only errors accumulate.
    if json_mode:
        print(json.dumps({"protocol": 1, "session_id": SID, "type": "progress",
                          "phase": "tool_ran", "tool": "bash", "label": "Bash",
                          "detail": "fake tool ran"}), flush=True)
    print("deliberate child failure", file=sys.stderr)
    sys.exit(7)
payload = {"prompt": prompt, "cwd": os.getcwd(), "resume": resume,
           "model": os.environ.get("GRAY_MODEL"),
           "effort": os.environ.get("GRAY_THINKING_EFFORT"),
           "active": os.environ.get("GRAY_SUBAGENTS_ACTIVE"),
           "compact_at": os.environ.get("GRAY_COMPACT_AT"),
           "provider": os.environ.get("GRAY_PROVIDER_ID"),
           "auth": os.environ.get("GRAY_AUTH_REF"),
           "base_url": os.environ.get("GRAY_BASE_URL")}
if json_mode:
    # "quiet" phases emit a result but no tool row — no progress evidence.
    if mode != "quiet":
        print(json.dumps({"protocol": 1, "session_id": SID, "type": "progress",
                          "phase": "tool_ran", "tool": "bash", "label": "Bash",
                          "detail": "fake tool ran"}))
    print(json.dumps({"protocol": 1, "session_id": SID, "type": "result",
                      "text": json.dumps(payload)}))
else:
    print(json.dumps(payload))
